{
  "name": "@budment/sdk",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budment/budment.git",
    "directory": "packages/sdk"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "dev": "tsup --watch --dts",
    "build": "tsup --dts"
  },
  "devDependencies": {
    "@budment/tsconfig": "workspace:*",
    "@types/node": "^26.5.1",
    "ts-proto": "^2.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "tsup": "^8.5.1"
  }
}
