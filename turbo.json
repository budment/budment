{
  "globalDependencies": [".env.*local", "proto/*.proto", "buf.gen.yaml"],
  "pipeline": {
    "generate": {
      "outputs": ["apps/core/internal/pb/", "packages/sdk/src/pb/"],
      "cache": true
    },

    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/", "bin/", ".next/", "!.next/cache/"],
      "cache": true
    },

    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "clean": {
      "cache": false
    }
  }
}
